{
  "expo": {
    "name": "Fominha Entregador",
    "slug": "fominha-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fominhadriver",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fominhadelivery.entregador",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para te conectar a entregas próximas e mostrar a rota até o destino.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.fominhadelivery.entregador",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7A0A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização enquanto você está online ou em uma entrega, inclusive com o app em segundo plano durante a entrega, para mostrar ao cliente onde o pedido está e traçar a rota até o destino.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E0B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/fominha-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F59E0B"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ab76fb1-b2d3-4491-84d1-c1163d214de2"
      }
    },
    "owner": "antjefferson"
  }
}
